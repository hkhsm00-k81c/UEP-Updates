const makeRecords=sheets=>{const out=[],seen=new Set();const genericSheet=/^(sheet\d*|시트\d*|교과학습발달상황|세부능력.*특기사항|세특)$/i;const cleanSheetSubject=name=>{const s=norm(name).replace(/\(\d+\)$/,'').replace(/^\d+\s*[-_.]\s*/,'').trim();return s&&!genericSheet.test(s)&&s.length<=40?s:"";};const validSubject=s=>{s=norm(s);return !!s&&s.length<=40&&/[가-힣A-Za-z]/.test(s)&&!/^(과\s*목|학년|반|번호|학번|성명|학생명|이름|세부능력|특기사항|세특)$/i.test(s)&&!/^\d+(?:\.0)?$/.test(s);};(sheets||[]).forEach(sheet=>{const rows=Array.isArray(sheet?.rows)?sheet.rows:[];if(!rows.length)return;const h=findHeader(rows),headers=h.row.map((v,i)=>norm(v)||("열"+(i+1)));const indexOf=(rx,fallback)=>{const i=headers.findIndex(x=>rx.test(x));return i>=0?i:fallback;};const subjectIndex=indexOf(/과목명|교과목|^과\s*목$/,1),gradeIndex=indexOf(/^학\s*년$|학년/,2),classIndex=indexOf(/^반$|학급|반명/,3),numberIndex=indexOf(/학번|학생번호|^번호$|번\s*호/,4),nameIndex=indexOf(/성명|학생명|성\s*명|이름/,5),textIndex=indexOf(/세부능력|특기사항|세특/,7);let currentSubject=cleanSheetSubject(sheet?.name||""),currentGrade="",currentClass="";rows.slice(h.index+1).forEach((row,rowIndex)=>{const cells=(row||[]).map(norm);if(!cells.some(Boolean))return;for(const cell of cells){let m=cell.match(/^(\d+)\s*학년\s*(\d+)\s*반$/);if(!m)m=cell.match(/^(\d+)\s*[-–]\s*(\d+)\s*반?$/);if(m){currentGrade=String(parseInt(m[1],10));currentClass=String(parseInt(m[2],10));}}if(cells.some(x=>/^과\s*목$/.test(x))&&cells.some(x=>/세부능력|특기사항/.test(x)))return;const rawSubject=cells[subjectIndex]||"";if(validSubject(rawSubject))currentSubject=rawSubject;else{const shortCandidates=cells.filter((x,i)=>i!==nameIndex&&i!==textIndex&&validSubject(x));const probable=shortCandidates.find(x=>x===cleanSheetSubject(sheet?.name||""))||shortCandidates.find(x=>x.length>=2&&x.length<=30&&!/^[가-힣]{2,5}$/.test(x));if(probable)currentSubject=probable;}const rawGrade=cells[gradeIndex]||"",rawClass=cells[classIndex]||"";if(/^\d+(?:\.0)?$/.test(rawGrade))currentGrade=String(parseInt(rawGrade,10));if(/^\d+(?:\.0)?$/.test(rawClass))currentClass=String(parseInt(rawClass,10));const text=cells[textIndex]||cells.filter(x=>x.length>=15).sort((a,b)=>b.length-a.length)[0]||"";if(text.length<15)return;let rawNo=cells[numberIndex]||"";const fourDigitCell=cells.find(x=>/^\d{4}(?:\.0)?$/.test(x));if(fourDigitCell)rawNo=fourDigitCell;const cleanNo=String(rawNo).replace(/\.0$/,"").replace(/[^0-9]/g,"");let studentNo=cleanNo,grade=currentGrade,classNo=currentClass,number="";if(/^\d{4}$/.test(cleanNo)){grade=cleanNo.slice(0,1);classNo=String(parseInt(cleanNo.slice(1,2),10));number=cleanNo.slice(2,4);}else if(cleanNo){number=String(parseInt(cleanNo,10)).padStart(2,"0");if(grade&&classNo)studentNo=`${grade}${classNo}${number}`;}if(/^\d{4}$/.test(studentNo)){grade=studentNo.slice(0,1);classNo=String(parseInt(studentNo.slice(1,2),10));number=studentNo.slice(2,4);}const name=cells[nameIndex]||cells.find(x=>/^[가-힣]{2,5}$/.test(x)&&x!==currentSubject)||"";let subject=validSubject(rawSubject)?rawSubject:currentSubject||cleanSheetSubject(sheet?.name||"")||"과목 미확인";if(!validSubject(subject))subject="과목 미확인";const dedupe=[studentNo,name,subject,text].join("|");if(seen.has(dedupe))return;seen.add(dedupe);const issues=[];forbidden.forEach(([category,rx,enabled])=>{if(enabled===false)return;rx.lastIndex=0;const hits=[...text.matchAll(rx)].map(m=>m[0]);if(hits.length)issues.push({category,hits:[...new Set(hits)],reason:"2026 학교생활기록부 기재요령 및 학교 점검 규칙에 따라 문맥 확인이 필요합니다."});});if(subject==="과목 미확인")issues.push({category:"과목 미확인",hits:[],reason:"원본 엑셀에서 과목명을 연결하지 못했습니다."});if(!/^\d{4}$/.test(studentNo))issues.push({category:"학번 확인",hits:[],reason:"학년·반·번호를 안정적으로 복원하지 못했습니다. 원본의 학번/번호 열을 확인하세요."});if(/[A-Za-z]{12,}/.test(text))issues.push({category:"긴 영문 표현",hits:(text.match(/[A-Za-z][A-Za-z\s-]{11,}/g)||[]).slice(0,4),reason:"불필요한 영문 표현 또는 고유명사 여부를 확인하세요."});if(/[=<>±×÷√∑∫^_{}]/.test(text))issues.push({category:"수식·특수기호",hits:(text.match(/[=<>±×÷√∑∫^_{}]+/g)||[]).slice(0,6),reason:"나이스 입력과 한글 서술 원칙에 맞는 표현인지 확인하세요."});out.push({id:[sheet.name,rowIndex,studentNo,name,subject].join(":"),sheet:String(sheet.name||""),row:rowIndex+h.index+2,studentNo,name,grade,classNo,number,subject,text,issues});});});return out;};
