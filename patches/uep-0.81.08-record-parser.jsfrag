const makeRecords=sheets=>{const out=[],seen=new Set();(sheets||[]).forEach(sheet=>{const rows=Array.isArray(sheet?.rows)?sheet.rows:[];if(!rows.length)return;const h=findHeader(rows),headers=h.row.map((v,i)=>norm(v)||("열"+(i+1)));const indexOf=(rx,fallback)=>{const i=headers.findIndex(x=>rx.test(x));return i>=0?i:fallback;};const subjectIndex=indexOf(/과목명|과\s*목/,1),gradeIndex=indexOf(/학\s*년/,2),classIndex=indexOf(/^반$|학급/,3),numberIndex=indexOf(/학번|학생번호|번\s*호/,4),nameIndex=indexOf(/성명|학생명|성\s*명|이름/,5),textIndex=indexOf(/세부능력|특기사항|세특/,7);let currentSubject="",currentGrade="",currentClass="";rows.slice(h.index+1).forEach((row,rowIndex)=>{const cells=(row||[]).map(norm);if(!cells.some(Boolean))return;const section=cells.find(x=>/^\d+학년\s*\d+반$/.test(x));if(section){const m=section.match(/^(\d+)학년\s*(\d+)반$/);currentGrade=m?.[1]||currentGrade;currentClass=m?.[2]||currentClass;return;}if(cells.some(x=>/^과\s*목$/.test(x))&&cells.some(x=>/세부능력|특기사항/.test(x)))return;const rawSubject=cells[subjectIndex]||"";if(rawSubject&&!/^과\s*목$/.test(rawSubject)&&!/학년\s*\d+반/.test(rawSubject)&&rawSubject.length<60)currentSubject=rawSubject;const rawGrade=cells[gradeIndex]||"",rawClass=cells[classIndex]||"";if(/^\d+(?:\.0)?$/.test(rawGrade))currentGrade=String(parseInt(rawGrade,10));if(/^\d+(?:\.0)?$/.test(rawClass))currentClass=String(parseInt(rawClass,10));const text=cells[textIndex]||cells.slice().filter(x=>x.length>=15).sort((a,b)=>b.length-a.length)[0]||"";if(text.length<15)return;const rawNo=cells[numberIndex]||"",name=cells[nameIndex]||cells.find(x=>/^[가-힣]{2,5}$/.test(x))||"";const cleanNo=String(rawNo).replace(/\.0$/,"").replace(/[^0-9]/g,"");const studentNo=/^\d{4}$/.test(cleanNo)?cleanNo:(currentGrade&&currentClass&&cleanNo?`${currentGrade}${currentClass}${cleanNo.padStart(2,"0")}`:cleanNo),subject=currentSubject||"과목 미확인",classNo=currentClass||String(studentNo).slice(1,2)||"-",dedupe=[studentNo,name,subject,text].join("|");if(seen.has(dedupe))return;seen.add(dedupe);const issues=[];forbidden.forEach(([category,rx,enabled])=>{if(enabled===false)return;rx.lastIndex=0;const hits=[...text.matchAll(rx)].map(m=>m[0]);if(hits.length)issues.push({category,hits:[...new Set(hits)],reason:"2026 학교생활기록부 기재요령 및 학교 점검 규칙에 따라 문맥 확인이 필요합니다."});});if(subject==="과목 미확인")issues.push({category:"과목 미확인",hits:[],reason:"원본 엑셀에서 과목명을 연결하지 못했습니다."});if(/[A-Za-z]{12,}/.test(text))issues.push({category:"긴 영문 표현",hits:(text.match(/[A-Za-z][A-Za-z\s-]{11,}/g)||[]).slice(0,4),reason:"불필요한 영문 표현 또는 고유명사 여부를 확인하세요."});if(/[=<>±×÷√∑∫^_{}]/.test(text))issues.push({category:"수식·특수기호",hits:(text.match(/[=<>±×÷√∑∫^_{}]+/g)||[]).slice(0,6),reason:"나이스 입력과 한글 서술 원칙에 맞는 표현인지 확인하세요."});out.push({id:[sheet.name,rowIndex,studentNo,name,subject].join(":"),sheet:String(sheet.name||""),row:rowIndex+h.index+2,studentNo,name,classNo,subject,text,issues});});});return out;};
